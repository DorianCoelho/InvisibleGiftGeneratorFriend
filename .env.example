# =============================================================================
#  Amigo Invisible · configuración
#  Copia este archivo a ".env" y rellena los valores:  cp .env.example .env
#  ¡Nunca subas el archivo .env al repositorio!
# =============================================================================

# --- Aplicación --------------------------------------------------------------
NODE_ENV=development
PORT=3000
# URL pública con la que los participantes abren los enlaces de los correos.
#   Desarrollo: http://localhost:5173 (servidor de Vite)
#   Producción: https://amigo.tudominio.com (obligatorio https)
APP_BASE_URL=http://localhost:5173

# Secreto para firmar (HMAC) los tokens y cifrar el resultado del sorteo.
# OBLIGATORIO, mínimo 32 caracteres. Genera uno con:  openssl rand -base64 48
# Si lo cambias, todos los enlaces existentes dejarán de funcionar.
TOKEN_SECRET=

# --- Correo electrónico ------------------------------------------------------
# smtp    -> cualquier servidor SMTP (Gmail, Outlook, Brevo SMTP, Mailgun...)
# brevo   -> API transaccional de Brevo (solo necesita BREVO_API_KEY)
# console -> solo desarrollo: muestra los correos en la terminal, no los envía
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=Amigo Invisible
EMAIL_FROM_ADDRESS=no-reply@tudominio.com
# Intentos por correo antes de marcarlo como fallido (reintentable desde el panel)
EMAIL_MAX_ATTEMPTS=3

# SMTP (EMAIL_PROVIDER=smtp). Ejemplos:
#   Brevo:   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURE=false
#   Gmail:   SMTP_HOST=smtp.gmail.com        SMTP_PORT=465  SMTP_SECURE=true  (usa una "contraseña de aplicación")
#   Outlook: SMTP_HOST=smtp-mail.outlook.com SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Brevo API (EMAIL_PROVIDER=brevo). Panel de Brevo > SMTP & API > API Keys
BREVO_API_KEY=

# --- Datos (archivos JSON) ---------------------------------------------------
# Directorio privado donde se guardan los grupos. Ruta relativa a la raíz del proyecto.
DATA_DIR=App_Data
# Días que se conserva un grupo antes de borrarse automáticamente.
GROUP_RETENTION_DAYS=90
# Borrar los datos del grupo en cuanto todos los participantes reciben su resultado.
DELETE_GROUP_WHEN_COMPLETED=true
# Copias de seguridad que se conservan por grupo.
BACKUPS_TO_KEEP=5

# --- Reglas de negocio -------------------------------------------------------
INVITATION_TTL_HOURS=72
MAX_PARTICIPANTS=50
# Minutos mínimos entre dos reenvíos de invitación al mismo participante.
RESEND_COOLDOWN_MINUTES=5

# --- Seguridad / red ---------------------------------------------------------
# Redirige HTTP->HTTPS y activa HSTS. Activado por defecto en producción.
FORCE_HTTPS=false
# Número de proxies inversos delante de la app (Caddy, Nginx...). "false" si no hay ninguno.
TRUST_PROXY=false
RATE_LIMIT_CREATE_GROUP_PER_HOUR=5
RATE_LIMIT_RESEND_PER_HOUR=20
RATE_LIMIT_API_PER_15_MIN=300

# --- Logs --------------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info
